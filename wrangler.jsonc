{
  "name": "fragrant-brook-7554",
  "compatibility_date": "2026-08-17",
  "main": "./worker-router.js",

  "workers_dev": false,
  "preview_urls": false,

  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": [
      "/api/*",
      "/"
    ]
  },

  "vars": {
    "TEAM_DOMAIN": "https://sdlive-show.cloudflareaccess.com",
    "POLICY_AUD": "510624979f4eb3e43797993696d0a49ecb7812dab18a4c3f48e9569ae8254d02"
  },

  "d1_databases": [
    {
      "binding": "CMS_DB",
      "database_name": "sdlive-cms-production",
      "database_id": "102616c5-bbe7-417a-9a7a-c0a062f91134"
    }
  ]
}
